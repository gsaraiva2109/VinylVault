{
  "name": "vinyl-vault",
  "version": "1.3.5",
  "description": "VinylVault — Tauri desktop app",
  "author": "gsaraiva2109",
  "repository": "https://github.com/gsaraiva2109/vinylvault",
  "scripts": {
    "dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "build": "tauri build",
    "build:frontend": "bash scripts/build-frontend.sh",
    "build:linux": "pnpm build:frontend && tauri build --target x86_64-unknown-linux-gnu",
    "build:mac": "pnpm build:frontend && tauri build --target aarch64-apple-darwin",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
